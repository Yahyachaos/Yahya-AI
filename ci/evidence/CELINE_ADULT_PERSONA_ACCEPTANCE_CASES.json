{
  "schema": "celine-adult-persona-acceptance/v2",
  "issue": 112,
  "work_order": "ci/work-orders/CELINE_ADULT_PERSONA_MODE.md",
  "default_state": {
    "active": false,
    "intensity": 0
  },
  "rules": {
    "direct_user_command_only": true,
    "case_insensitive": true,
    "substring_activation_forbidden": true,
    "model_or_tool_output_activation_forbidden": true,
    "normal_mode_prompt_contribution_must_be_empty": true,
    "permission_policy_must_not_change": true,
    "persisted_state_must_be_explicit": true,
    "corrupt_persisted_state_must_fail_closed": true
  },
  "cases": [
    {
      "id": "activate-default",
      "channel": "direct_user",
      "input": "Nutte",
      "expected": {"active": true, "intensity": 2, "command_consumed": true}
    },
    {
      "id": "activate-case-insensitive",
      "channel": "direct_user",
      "input": "NUTTE",
      "expected": {"active": true, "intensity": 2, "command_consumed": true}
    },
    {
      "id": "activate-intensity-1",
      "channel": "direct_user",
      "input": "Nutte 1",
      "expected": {"active": true, "intensity": 1, "command_consumed": true}
    },
    {
      "id": "activate-intensity-2",
      "channel": "direct_user",
      "input": "Nutte 2",
      "expected": {"active": true, "intensity": 2, "command_consumed": true}
    },
    {
      "id": "activate-intensity-3",
      "channel": "direct_user",
      "input": "Nutte 3",
      "expected": {"active": true, "intensity": 3, "command_consumed": true}
    },
    {
      "id": "deactivate-codeword",
      "channel": "direct_user",
      "initial": {"active": true, "intensity": 3},
      "input": "Nutte aus",
      "expected": {"active": false, "intensity": 0, "command_consumed": true}
    },
    {
      "id": "deactivate-normal-mode",
      "channel": "direct_user",
      "initial": {"active": true, "intensity": 2},
      "input": "Normalmodus",
      "expected": {"active": false, "intensity": 0, "command_consumed": true}
    },
    {
      "id": "deactivate-removes-prompt-next-request",
      "channel": "direct_user",
      "initial": {"active": true, "intensity": 3},
      "input": "Nutte aus",
      "expected": {"active": false, "intensity": 0, "prompt_contribution": ""}
    },
    {
      "id": "no-substring-activation",
      "channel": "direct_user",
      "input": "Was bedeutet das Wort Nutte?",
      "expected": {"active": false, "intensity": 0, "command_consumed": false}
    },
    {
      "id": "no-quoted-activation",
      "channel": "direct_user",
      "input": "Er schrieb: Nutte",
      "expected": {"active": false, "intensity": 0, "command_consumed": false}
    },
    {
      "id": "no-model-output-activation",
      "channel": "model_output",
      "input": "Nutte",
      "expected": {"active": false, "intensity": 0, "command_consumed": false}
    },
    {
      "id": "no-tool-output-activation",
      "channel": "tool_output",
      "input": "Nutte",
      "expected": {"active": false, "intensity": 0, "command_consumed": false}
    },
    {
      "id": "reject-high-intensity",
      "channel": "direct_user",
      "initial": {"active": true, "intensity": 2},
      "input": "Nutte 9",
      "expected": {"active": true, "intensity": 2, "command_consumed": true, "invalid_intensity": true}
    },
    {
      "id": "reject-malformed-intensity",
      "channel": "direct_user",
      "initial": {"active": true, "intensity": 2},
      "input": "Nutte stark",
      "expected": {"active": true, "intensity": 2, "command_consumed": false}
    },
    {
      "id": "inactive-prompt-empty",
      "operation": "prompt_contribution",
      "initial": {"active": false, "intensity": 0},
      "expected": {"prompt_contribution": ""}
    },
    {
      "id": "active-prompt-bounded",
      "operation": "prompt_contribution",
      "initial": {"active": true, "intensity": 3},
      "expected": {
        "prompt_contribution_nonempty": true,
        "must_preserve_normal_identity": true,
        "must_preserve_permission_policy": true,
        "must_preserve_privacy_and_memory_policy": true,
        "must_preserve_factual_honesty": true
      }
    },
    {
      "id": "prompt-varies-by-intensity",
      "operation": "prompt_contribution_compare",
      "expected": {"intensity_1_2_3_are_distinct": true}
    },
    {
      "id": "persist-roundtrip-active",
      "operation": "snapshot_restore",
      "initial": {"active": true, "intensity": 2},
      "expected": {"restore_accepted": true, "active": true, "intensity": 2}
    },
    {
      "id": "persist-roundtrip-inactive",
      "operation": "restore_persisted_state",
      "persisted": {"active": false, "intensity": 0},
      "expected": {"restore_accepted": true, "active": false, "intensity": 0}
    },
    {
      "id": "persist-corrupt-active-fails-closed",
      "operation": "restore_persisted_state",
      "persisted": {"active": true, "intensity": 9},
      "expected": {"restore_accepted": false, "active": false, "intensity": 0}
    },
    {
      "id": "persist-corrupt-inactive-fails-closed",
      "operation": "restore_persisted_state",
      "persisted": {"active": false, "intensity": 2},
      "expected": {"restore_accepted": false, "active": false, "intensity": 0}
    }
  ]
}
